{
    "name": "loki/magento2-page-stats",
    "version": "0.0.3",
    "description": "Developer tool to report various page loading statistics",
    "type": "magento2-module",
    "require": {
        "magento/framework": "^103.0",
        "php": ">=8.2 <8.6"
    },
    "require-dev": {
        "ext-pcre": "*",
        "loki/magento2-functional-tests": "@dev",
        "phpunit/phpunit": "^10.5",
        "yireo/magento2-integration-test-helper": "~0.0"
    },
    "license": [
        "OSL-3.0"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
